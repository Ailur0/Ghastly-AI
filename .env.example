# Copy this file to .env and fill in your real API keys.
# Never commit .env — it's already in .gitignore.

# === STT (Groq Whisper API) ===
GROQ_API_KEY=your-groq-api-key
GROQ_WHISPER_MODEL=whisper-large-v3

# === LLM (Groq Cloud) ===
# The app used to run on Ollama Cloud; it now talks to Groq's
# OpenAI-compatible endpoint. The OLLAMA_* names still exist inside config.py
# as aliases, but they are no longer read from the environment — set these.
# This can be the same key as GROQ_API_KEY above.
GROQ_LLM_API_KEY=your-groq-api-key
GROQ_LLM_MODEL=openai/gpt-oss-120b
# Must be a vision-capable model on your key — see GET /openai/v1/models.
GROQ_LLM_VISION_MODEL=qwen/qwen3.8-27b
GROQ_LLM_BASE_URL=https://api.groq.com/openai/v1

# === Hotkeys ===
# Also editable from the setup panel, which writes changes back to .env.
# Use the `keyboard` library's spelling: ctrl / alt / shift / windows.
SCREEN_CAPTURE_HOTKEY=ctrl+shift+h
PANIC_HOTKEY=ctrl+shift+space
OPACITY_HOTKEY=ctrl+shift+o
RETRY_HOTKEY=ctrl+shift+r

# === Answer what was just said ===
# Transcribes the last GRAB_SECONDS of audio and answers it, skipping the
# question filter. Press it after the question has been asked.
GRAB_HOTKEY=ctrl+;
GRAB_SECONDS=20
