# Copy this file to .env and fill in your real API keys.
# Never commit .env — it's already in .gitignore.

# === STT (Groq Whisper API) ===
GROQ_API_KEY=your-groq-api-key
GROQ_WHISPER_MODEL=whisper-large-v3

# === LLM (Ollama Cloud) ===
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_MODEL=glm-4.5
OLLAMA_BASE_URL=https://api.ollama.com/api

# === Vision LLM (OpenRouter) — used by the screen capture feature ===
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Screen Capture ===
SCREEN_CAPTURE_HOTKEY=ctrl+shift+h
